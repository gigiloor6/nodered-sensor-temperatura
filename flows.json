    {
        "id": "d2a0000000000009",
        "type": "ui-template",
        "z": "d2a0000000000001",
        "group": "d2a0000000000014",
        "page": "",
        "ui": "",
        "name": "LED alarma",
        "order": 2,
        "width": "3",
        "height": "3",
        "head": "",
        "format": "<template>\n  <div class=\"led-box\">\n    <div class=\"led\" :style=\"{ backgroundColor: color, boxShadow: '0 0 18px ' + color }\"></div>\n    <span class=\"led-text\">{{ texto }}</span>\n  </div>\n</template>\n\n<script>\nexport default {\n  computed: {\n    alarma () {\n      return this.msg && this.msg.payload === true\n    },\n    color () {\n      return this.alarma ? '#e53935' : '#43a047'\n    },\n    texto () {\n      if (!this.msg || this.msg.temperatura === undefined) return 'Esperando datos...'\n      return (this.alarma ? 'ALARMA: ' : 'Normal: ') + this.msg.temperatura + ' °C'\n    }\n  }\n}\n</script>\n\n<style scoped>\n.led-box { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; height: 100%; padding: 8px; }\n.led { width: 60px; height: 60px; border-radius: 50%; transition: background-color 0.3s, box-shadow 0.3s; }\n.led-text { font-size: 18px; font-weight: bold; }\n</style>",
        "storeOutMessages": true,
        "passthru": false,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
