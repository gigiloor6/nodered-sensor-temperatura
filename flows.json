        "type": "function",
        "z": "d2a0000000000001",
        "name": "Simular temperatura",
        "func": "// Genera una temperatura aleatoria entre 20 y 40 °C con un decimal\nconst temp = 20 + Math.random() * 20;\nmsg.payload = Math.round(temp * 10) / 10;\nmsg.topic = \"Temperatura\";\nreturn msg;",
